# ── Defaults from the bitbucket starter ──────────────────────────────
# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by macOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# ── Node / frontend ──────────────────────────────────────────────────
.npm/
.pnpm-store/
.yarn/
.cache/
.vite/
.turbo/
.next/
.nuxt/
.svelte-kit/
.output/
build/
out/
*.tsbuildinfo

# ── IDE / editor files ───────────────────────────────────────────────
.vscode/
.cursor/
.zed/
.idea/
*.swp
*.swo
*~
.history/

# ── Environment / secrets — NEVER commit ─────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets.json
credentials.json

# ── App runtime data (NOT source) ────────────────────────────────────
# Per-run snapshots, shadow git, sqlite indexes, conversation logs.
# These are populated when the user actually uses the IDE and have no
# place in source control.
logs/
runs/
workspace/
.shadow-git/
*.sqlite
*.sqlite3
*.db

# Pi sessions / scratchpads (regenerated on first run)
.pi/sessions/
.pi/cache/
# FastAPI backend stores per-RPC-session JSONL transcripts here.
web/sessions/

# Local symlinks pointing OUTSIDE the repo (e.g. dev guides)
guides

# ── Bundler / packaging output ───────────────────────────────────────
*.zip
*.tar
*.tar.gz
*.tgz

# ── OS / misc ────────────────────────────────────────────────────────
.DS_Store?
.AppleDouble
.LSOverride
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
