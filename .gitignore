# ─────────────────────────────────────────────────────────────────────────────
# Runtime data — NEVER commit. Lives on the VM disk + nightly GCS backups.
# ─────────────────────────────────────────────────────────────────────────────
web/data/
data/
runs/
logs/

# Cursor "Export chat" markdown dumps — these end up at the repo root
# every time we run a postmortem or share a transcript, and they're
# always many MB of one-off context that has no business in source.
cursor_*.md

# ─────────────────────────────────────────────────────────────────────────────
# Secrets / local config
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# Code-signing material. The .cer (public certificate) is harmless to
# commit but carries no value in source control — it lives in Keychain
# Access on the build machine. The .p12 / .pfx / .pem / .key files
# bundle the private key and would let anyone with the file impersonate
# us as a Developer ID signer; they MUST never be tracked. The CSR is
# pointless to keep around once Apple has issued the cert.
*.cer
*.p12
*.pfx
*.pem
*.key
*.certSigningRequest
AuthKey_*.p8
web/backend/.env
web/backend/.env.*
!web/backend/.env.example
web/frontend/.env
web/frontend/.env.local
web/frontend/.env.*.local

# Production stack.env is generated locally and shipped to the VM via
# `remote-deploy.sh stack`. Holds Clerk + Stripe + Cloudflare keys so
# it must NEVER be committed. Only the `.example` template is tracked.
deploy/stack.env
deploy/stack.env.local

# ─────────────────────────────────────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
.venv/
**/.venv/
venv/
**/venv/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─────────────────────────────────────────────────────────────────────────────
# Build / dist artifacts
# ─────────────────────────────────────────────────────────────────────────────
web/frontend/dist/
web/frontend/dist-ssr/
*.local
.vite/
**/.vite/
*.tsbuildinfo

# ─────────────────────────────────────────────────────────────────────────────
# OS / editor noise
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.cursor/

# ─────────────────────────────────────────────────────────────────────────────
# Logs / crash dumps
# ─────────────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─────────────────────────────────────────────────────────────────────────────
# Pi / probe / live-test scratch
# ─────────────────────────────────────────────────────────────────────────────
.pi-cache/
*.probe.json
scripts/_scratch/

# ─────────────────────────────────────────────────────────────────────────────
# Vendored pi-coding-agent / pi-ai patch artefacts.
#
# `patches/apply-edits.mjs` rewrites files inside the bundled pi runtime
# (desktop/pi-runtime/vendor/pi/...). It does NOT read patches/backups/*.
# Those .js files were snapshots of the pre-patch upstream copies kept
# around in case we ever needed to diff them, but at this point they're
# 600 KB of stale JavaScript that just makes `git status` noisy. The
# patcher is idempotent (sentinel-guarded — see apply-edits.mjs#patch),
# so the backups give us nothing the upstream package versions can't.
#
# The historic copies are still tracked from before this rule existed;
# `git rm -r --cached patches/backups/` (run once, intentionally) is
# what actually drops them out of the index.
patches/backups/
.release-secrets.tmp.env

# Build orchestration outputs (added 2026-05-09)
.env-build
.release-secrets.tmp.env
desktop/build-out/
.dev-logs/
.gcloudignore
