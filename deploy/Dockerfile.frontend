# Frontend build image — produces a `dist/` of the Vue 3 SPA that
# scripts/remote-deploy.sh extracts to /srv/pi/www on the VM. Caddy
# mounts that path read-only and serves it at the apex.
#
# We don't run this image at runtime; we just `docker build` it and
# then `docker run --rm <img>` to stream the dist tarball out. Pinning
# Node + a deterministic build container guarantees reproducible SPA
# bundles across deploys.

ARG NODE_VERSION=22.18.0

FROM node:${NODE_VERSION}-bookworm-slim AS builder

WORKDIR /app

# Lockfile-only first so the install layer caches across source edits.
COPY web/frontend/package.json web/frontend/package-lock.json* ./
RUN npm ci --no-audit --no-fund

COPY web/frontend/ ./
# VITE_API_BASE is unset → SPA uses the same-origin "/api" prefix,
# which Caddy reverse-proxies to the backend. Everything stays on
# https://digi-setu.com — no CORS, no separate API host.
RUN npm run build

# Final tiny stage that just owns the dist tree. Built once, then
# scripts/remote-deploy.sh extracts /dist via `docker run`.
FROM busybox:1.37.0
COPY --from=builder /app/dist /dist
CMD ["sh", "-c", "tar -C /dist -cf - ."]
