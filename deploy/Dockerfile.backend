# pi-typst-test backend image for the hosted deployment (digi-setu.com).
#
# Mirrors the layout of the legacy typst-agent stack but adapted to the
# pi-coding-agent runtime: FastAPI (Python) is the public surface and pi
# itself is a Node CLI we shell out to per chat session.
#
# Threat model recap (v1, BEFORE the runuser sandbox lands in v1.1):
#   * the AI runs as the same uid as the backend ("app", uid 1100). All
#     filesystem-touching tools (write/edit/read/bash) are bounded by
#     the workspace path the agent's `cwd` was set to.
#   * /opt/pi/stack.env (deployed secrets) is mounted 0600 root and the
#     backend opens it once at boot via systemd EnvironmentFile, then
#     drops to uid 1100 — the AI literally cannot read it.
#   * /srv/pi/state (auth.db, JWT key, registry.json) is 0700 root and
#     the backend mediates every read.
#
# Phase-5 (web hardening): swap the workspace cwd execve into a runuser
# drop the same way typst-agent does so even an `ls /` from inside the
# AI shows nothing it shouldn't.
#
# Contents:
#   - Python 3.11 (slim-bookworm) + uvicorn + watchdog
#   - Node 22 (the pi-coding-agent runtime)
#   - The repo's package.json deps + the pi vertex-anthropic patch
#   - tini (PID 1, reaps zombies — the agent forks bash + bg processes)
#   - git (shadow-git per workspace), curl, ca-certs

ARG PYTHON_VERSION=3.11.10
ARG NODE_MAJOR=22
ARG TYPST_VERSION=0.14.2

FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime

ARG NODE_MAJOR
ARG TYPST_VERSION

ENV DEBIAN_FRONTEND=noninteractive

# Microsoft EULA pre-accept for ttf-mscorefonts-installer (Arial/Times/Calibri).
RUN echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" \
      | debconf-set-selections

# OS packages. Two groups, kept in ONE RUN so the layer is monolithic and
# the apt cache is wiped before commit:
#   * runtime essentials (Python deps already installed via slim-bookworm)
#   * Tier-A OSS font pack — what every doc-renderer expects to find on
#     the system. Without these, Typst silently substitutes Linux
#     Libertine for everything.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        fontconfig \
        fonts-dejavu \
        fonts-firacode \
        fonts-inter \
        fonts-lato \
        fonts-liberation \
        fonts-noto-cjk \
        fonts-noto-color-emoji \
        fonts-noto-core \
        fonts-roboto \
        git \
        gnupg \
        tini \
        unzip \
        util-linux \
        xz-utils \
 && curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# Microsoft core fonts (Arial / Times / Calibri / etc) from Debian contrib.
# These are the fonts the AI most often picks because they render
# professionally and the user expects "Arial" to actually be Arial.
RUN echo "deb http://deb.debian.org/debian bookworm contrib" \
        > /etc/apt/sources.list.d/contrib.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends ttf-mscorefonts-installer \
 && rm -rf /var/lib/apt/lists/*

# ── Docker CLI ────────────────────────────────────────────────────
# The backend spawns one per-session container per chat by exec'ing
# `docker run pi-session …` against the host's docker.sock (mounted
# at /var/run/docker.sock — see deploy/docker-compose.yml). This needs
# the `docker` client binary on PATH inside the backend container.
#
# Without it, services/pi_session.py's `_detect_runtime()` silently
# falls back to spawning `pi` as a subprocess of the backend (the
# pre-Phase-6 sandbox), which means the per-session container security
# model is bypassed entirely — no kernel namespace isolation, no
# umasked workspace, no `sudo apt install` for the user, host paths
# leak into the chat. Hence: install ONLY the client (no daemon).
#
# We install from Docker's official repo (not Debian's docker.io
# package, which lags by ~2 minor versions). This adds ~50 MB to the
# backend image, all of it `docker-ce-cli` deps.
RUN curl -fsSL https://download.docker.com/linux/debian/gpg \
        | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg \
 && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian bookworm stable" \
        > /etc/apt/sources.list.d/docker.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends docker-ce-cli \
 && rm -rf /var/lib/apt/lists/* \
 && docker --version

# Pinned Typst — the musl static build (no glibc tying so it runs on
# any base image). Same version as the laptop dev env (0.14.2).
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) tarball="typst-x86_64-unknown-linux-musl.tar.xz" ;; \
      arm64) tarball="typst-aarch64-unknown-linux-musl.tar.xz" ;; \
      *) echo "unsupported arch $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/typst.tar.xz \
        "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/${tarball}"; \
    tar -xJf /tmp/typst.tar.xz -C /tmp; \
    install -m 0755 /tmp/typst-*/typst /usr/local/bin/typst; \
    rm -rf /tmp/typst*; \
    typst --version

# ── Dual-uid sandbox model ───────────────────────────────────────────
#
# Two non-root users live inside the image:
#
#   sandbox  uid 1000 / gid 1000   — the AI's effective identity. When
#                                    the backend spawns `pi --mode rpc`
#                                    via `setpriv --reuid 1000 --regid
#                                    1000`, every descendant (pi, the
#                                    AI's bash, typst, npm) runs as
#                                    this uid. Owns /home/sandbox.
#
#   app      uid 1100 / gid 1100   — the FastAPI backend. Has gid 1000
#                                    as a SECONDARY group so it can
#                                    rw shared resources (workspace
#                                    dirs, chat session dirs) via
#                                    group permission. Owns /home/app.
#
# Why two uids? It's the cheapest way to make the kernel — not the app
# layer — enforce the boundary between "the AI's bash" and "the
# backend's process":
#
#   /srv/pi/data/billing.db    0600 1100:1100  → sandbox cannot read
#   /srv/pi/data/registry.json 0600 1100:1100  → sandbox cannot read
#   /srv/pi/data/users/        0700 1100:1100  → sandbox cannot read
#   /srv/pi/data/chats/<sid>/  2770 1000:1000  → both rw via owner+group
#   /srv/pi/data/workspaces/   0710 1100:1000  → sandbox can chdir but
#                                                NOT enumerate other
#                                                workspaces (no read on
#                                                the dir, only execute)
#
# UUID-based session/workspace IDs (122 bits of entropy from uuid4)
# make brute-forcing a sibling wsid infeasible, so traverse-only on
# the parent is enough.
#
# The pi-firewall.service nftables ruleset blocks `skuid 1000` from
# reaching the GCP metadata server, so even if the AI's bash builds
# a curl one-liner the kernel drops the packet. The backend (uid
# 1100) keeps unrestricted egress so its own Vertex SDK can still
# fetch ADC tokens.
ARG DOCKER_GID=988

RUN groupadd --system --gid 1000 sandbox \
 && useradd  --system --uid 1000 --gid 1000 --home-dir /home/sandbox --create-home --shell /usr/sbin/nologin sandbox \
 && groupadd --system --gid 1100 app \
 && groupadd --system --gid "${DOCKER_GID}" docker_host \
 && useradd  --system --uid 1100 --gid 1100 --groups sandbox,docker_host --home-dir /home/app --create-home --shell /usr/sbin/nologin app

WORKDIR /app

# ── Python deps ───────────────────────────────────────────────────────
COPY web/backend/requirements.txt ./web/backend/requirements.txt
RUN pip install --no-cache-dir -r web/backend/requirements.txt

# ── pi-coding-agent + project npm tree ────────────────────────────────
# package.json declares pi as a devDependency, so we keep dev deps so
# `pi --extension ./extensions/typst-tools.ts` resolves to the same
# version as the operator runs locally. node_modules ends up at /app/
# node_modules just like in dev.
COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund \
 && ln -sf /app/node_modules/.bin/pi /usr/local/bin/pi

# ── Provider patches ──────────────────────────────────────────────────
# The anthropic-vertex provider patch lives in patches/. Apply it once
# at build time so every container boot inherits the patched provider.
# The script honours PI_PKG_GLOBAL — point it at our local install.
COPY patches/ ./patches/
RUN PI_PKG_GLOBAL=/app/node_modules/@mariozechner/pi-coding-agent \
    bash patches/apply.sh \
 && pi --version >/dev/null

# ── Source + extension assets ─────────────────────────────────────────
# These end up at /app/{extensions,guides,AGENTS.md,.pi,scripts,web} —
# the same layout dev runs against, so PROJECT_ROOT calculations in
# config.py / pi_session.py give the same answer.
COPY extensions/ ./extensions/
COPY guides/ ./guides/
COPY AGENTS.md ./AGENTS.md
COPY .pi/ ./.pi/
COPY scripts/ ./scripts/
COPY web/backend/ ./web/backend/

# ── Bundled fonts (Typst loads at compile time) ─────────────────────
# web/backend/fonts/ holds ~80 hand-curated TTF/OTF files (Inter, Lato,
# EB Garamond, FiraCode, Font Awesome, Academicons, etc.) the agent
# recommends in design briefs. Without them the AI's "use Inter" lands
# on the system Inter (Tier-A pack above) which is fine, but the
# specialty fonts (icons, symbols, slabs) only exist in this dir.
#
# We ship them at /app/fonts/ AND let fontconfig index them so both
# `typst compile --font-path` callers and `fc-list`-style discovery
# both find them. The fontconfig index is rebuilt as the LAST step
# (after all font sources are in place).
RUN install -d -m 0755 /usr/local/share/fonts/digi-setu
COPY web/backend/fonts/ /usr/local/share/fonts/digi-setu/

# Build the system fontconfig cache. Typst itself reads
# /usr/share/fonts directly (no fontconfig needed) but `fc-list` and
# every Pillow / matplotlib / cairo workflow does, so we build it.
RUN fc-cache -f -v | tail -5

# Lock the deployed code down. The backend (uid 1100, group app) and
# the sandbox uid (1000, NOT in group app) BOTH need to:
#   - traverse /app to reach /app/node_modules/.bin/pi
#   - execute pi + its npm-bundled binaries
#   - read /app/web/backend (uvicorn imports), /app/extensions (pi
#     loads typst-tools.ts at startup), /app/.pi (registry config)
#
# Original v1.0 chown-root:app + 0750/0640 only worked because pi ran
# as uid 1100 (group app member). v1.1 spins pi out to uid 1000 — at
# that point /app needs world-read+execute or pi crashes with a
# confusing "setpriv: failed to execute pi: Permission denied".
#
# Safety: NOTHING in /app is a secret. All runtime secrets (Clerk,
# Stripe, Cloudflare API tokens, ADMIN_*, JWT keys) come from
# /opt/pi/stack.env which is bind-mounted at runtime via docker-compose
# `env_file:`, NEVER baked into the image. The COPY rules above only
# pull source code + lockfiles + fonts, none of which contain creds.
# Dev .env files are .dockerignore'd / .gitignore'd at the source.
#
# Defence-in-depth: even if a stray .env did sneak in, the system-wide
# secret scrubber in pi_session.py (_PI_ENV_DENY) keeps every Clerk/
# Stripe/Cloudflare key OUT of the env handed to pi, so a hostile
# bash inside the AI can't `printenv` them either way.
#
# We use `chmod -R a+rX,go-w`:
#   a+r = add read for owner+group+other (so sandbox uid can read)
#   X   = add execute ONLY where it makes sense (directories, or
#         files that ALREADY have any execute bit set). This keeps
#         npm-installed binaries / shell scripts executable without
#         turning JSON / .ts / .js source files into misleadingly
#         executable files.
#   go-w = strip write for group+other (only owner=root writes /app)
RUN chown -R root:app /app \
 && chmod -R a+rX,go-w /app \
 && chmod 0755 /usr/local/bin/pi

# ── Runtime env ──────────────────────────────────────────────────────
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/web/backend \
    PI_MODE=web \
    PI_DATA_ROOT=/srv/pi/data \
    PI_PROVIDER=anthropic-vertex \
    PI_MODEL=claude-sonnet-4-6 \
    PI_VERTEX_ANTHROPIC_LOCATION=global \
    HOST=0.0.0.0 \
    PORT=8788 \
    \
    # Typst font discovery. Colon-separated, in priority order: the
    # bundled designer pack first (so e.g. "Inter" resolves to OUR
    # version even if the apt-installed `fonts-inter` differs), then
    # the system locations apt-installed fonts land in.
    TYPST_FONT_PATHS=/usr/local/share/fonts/digi-setu:/usr/local/share/fonts:/usr/share/fonts \
    \
    # @preview package cache. Bind-mounted to /srv/pi/data so packages
    # downloaded by one workspace persist for the next chat. The
    # pi-prepare.service unit creates this dir 0775 1100:1100.
    TYPST_PACKAGE_CACHE_PATH=/srv/pi/data/typst-packages \
    \
    # Where typst stores its own per-user cache (font index, etc).
    # Without this it tries to write to /home/app/.cache which IS
    # writable (we created the home dir above) but on every container
    # restart the index has to be rebuilt; pinning to the data volume
    # keeps it warm across rolls.
    #
    # NOTE: /srv/pi/data/.cache is owned 1000:1000 mode 2770 by the
    # pi-prepare.service unit, so the sandbox uid (1000) can write
    # AND the app user (1100) can read via secondary group membership.
    XDG_CACHE_HOME=/srv/pi/data/.cache \
    \
    # PI_SANDBOX_UID/GID are read by services/pi_session.py to decide
    # whether to wrap the pi exec in `setpriv --reuid --regid`. Set to
    # 0 to disable the sandbox (development laptop, where pi just
    # runs as the operator). In the container the values are 1000.
    PI_SANDBOX_UID=1000 \
    PI_SANDBOX_GID=1000

# Entrypoint that drops root → uid 1100 with CAP_{SETUID,SETGID,CHOWN,
# FOWNER} preserved as ambient caps. We deliberately do NOT use the
# Dockerfile `USER app` directive here: that would zero capabilities
# at exec time (kernel rule for non-root execve without file caps),
# which breaks our dual-uid sandbox because pi_session.py needs
# CAP_SETUID at runtime to spawn pi as uid 1000 via setpriv. Letting
# the entrypoint do the drop keeps caps in the ambient set across
# the uid change. See deploy/entrypoint-drop-priv.sh for the full
# rationale.
COPY deploy/entrypoint-drop-priv.sh /usr/local/bin/entrypoint-drop-priv.sh
RUN chmod 0555 /usr/local/bin/entrypoint-drop-priv.sh

EXPOSE 8788

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8788/healthz >/dev/null || exit 1

# tini reaps zombies cleanly when the agent kills bash/bg subprocesses.
# The drop-priv shim runs AFTER tini so PID 1 stays root (so it can
# reap zombies from any uid) while the backend itself is uid 1100.
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-drop-priv.sh"]
CMD ["python", "-m", "uvicorn", "main:app", \
     "--host", "0.0.0.0", "--port", "8788", \
     "--app-dir", "/app/web/backend", \
     "--proxy-headers", "--forwarded-allow-ips=*"]
