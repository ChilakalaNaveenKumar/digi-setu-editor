# /etc/systemd/system/pi-prepare.service
#
# One-shot unit that runs BEFORE pi.service on every boot.
# Materialises the on-disk layout under /srv/pi with the
# ownership + mode the docker-compose volumes expect.
#
# ── Dual-uid layout (v1.1) ────────────────────────────────────────
#
# This unit enforces the kernel-level isolation between the FastAPI
# backend and the AI-controlled bash subprocess. They share the same
# container but have distinct uids:
#
#   uid 1100 / gid 1100   — `app`     — backend (FastAPI + watchdog)
#   uid 1000 / gid 1000   — `sandbox` — pi --mode rpc + AI's bash
#
# `app` is in the `sandbox` group as a SECONDARY group so it can
# rw shared dirs (workspaces, chats, shadows, typst cache) via group
# permission, while keeping its primary gid 1100 for backend-private
# files (billing.db, registry.json, users/).
#
# ── Permission table ──────────────────────────────────────────────
#
#   /srv/pi/state            0700 root:root      auth.db, JWT key, OAuth state
#   /srv/pi/data             0710 1100:1000      backend rw, sandbox traverse-only
#   /srv/pi/data/billing.db  0600 1100:1100      backend EXCLUSIVE (not visible to AI)
#   /srv/pi/data/registry.json
#                            0600 1100:1100      backend EXCLUSIVE
#   /srv/pi/data/users/      0700 1100:1100      backend EXCLUSIVE (per-user prefs)
#   /srv/pi/data/workspaces/ 0710 1100:1000      backend rw, sandbox cd-by-uuid only
#   /srv/pi/data/workspaces/<wsid>/
#                            2770 1000:1000      sandbox owner, app via group; SGID
#   /srv/pi/data/chats/      0710 1100:1000      backend rw, sandbox cd-by-uuid only
#   /srv/pi/data/chats/<sid>/
#                            2770 1000:1000      sandbox owner, app via group; SGID
#   /srv/pi/data/shadows/    0710 1100:1000      backend rw, sandbox cd-by-uuid only
#   /srv/pi/data/shadows/<wsid>/
#                            2770 1000:1000      sandbox owner, app via group; SGID
#   /srv/pi/data/typst-packages/
#                            2775 1000:1000      shared cache, world-readable
#   /srv/pi/data/.cache/     2770 1000:1000      sandbox writes, app reads via group
#
# Mode 0710 on parent dirs is the key trick: it lets the sandbox
# uid `cd workspaces/<known-wsid>` (group --x = traverse) but `ls
# workspaces/` returns Permission denied (no group r). Combined
# with uuid4 wsids (122 bits of entropy), enumerating other
# workspaces is infeasible.
#
# SGID (the leading `2` in `2770`) makes new files inside per-session
# dirs inherit gid 1000, so a backend-written file is still readable
# by the sandbox via group permission and vice versa.
#
# ── Idempotent migration ──────────────────────────────────────────
#
# The unit also walks any pre-existing workspaces / chats / shadows
# (which were created with the old 0700 1100:1100 layout) and
# re-chowns them to 1000:1000 mode 2770. Safe to run on every boot.

[Unit]
Description=pi-typst-test — prepare /srv/pi layout
Before=pi.service
After=local-fs.target
RequiresMountsFor=/srv

[Service]
Type=oneshot
RemainAfterExit=yes

# State — root-only. Host the bearer-token JWT key + auth.db here.
ExecStart=/usr/bin/install -d -m 0700 -o 0    -g 0    /srv/pi/state

# Top-level data dir. Backend (1100) is owner with full rwx; sandbox
# group (1000) gets --x (traverse) but no r (no listing). Mode 0710
# is the critical bit — without it sandbox can't reach any subdir
# at all; with it sandbox can cd into a subdir BY NAME (if the
# subdir grants further perms) but cannot enumerate.
ExecStart=/usr/bin/install -d -m 0710 -o 1100 -g 1000 /srv/pi/data

# Backend-EXCLUSIVE subdirs. 0700 means even traverse is denied to
# sandbox, so a leaked path like /srv/pi/data/users/<uid>/prefs.json
# returns "Permission denied" before the AI can even check existence.
ExecStart=/usr/bin/install -d -m 0700 -o 1100 -g 1100 /srv/pi/data/users

# Per-session dirs (workspaces / chats / shadows). Parent is 0710 so
# sandbox can cd-by-uuid but not ls; per-session subdirs are 2770
# 1000:1000 (SGID set) so the sandbox owns them and the backend
# reaches them via secondary-group membership.
ExecStart=/usr/bin/install -d -m 0710 -o 1100 -g 1000 /srv/pi/data/workspaces
ExecStart=/usr/bin/install -d -m 0710 -o 1100 -g 1000 /srv/pi/data/chats
ExecStart=/usr/bin/install -d -m 0710 -o 1100 -g 1000 /srv/pi/data/shadows

# Migration sweep: any existing per-session dir from the v1.0
# layout (0700 1100:1100) gets re-stamped to 2770 1000:1000.
# `find -exec` is idempotent — re-running on already-migrated dirs
# is a no-op. The `-mindepth 1 -maxdepth 1` keeps the scope to
# direct children (per-session dirs); -mindepth 2 then handles
# everything BELOW each session dir.
ExecStart=/bin/bash -c "set -eux; \
  for parent in workspaces chats shadows; do \
    dir=/srv/pi/data/$parent; \
    [ -d $dir ] || continue; \
    find $dir -mindepth 1 -maxdepth 1 -type d -exec chown 1000:1000 {} +; \
    find $dir -mindepth 1 -maxdepth 1 -type d -exec chmod 2770 {} +; \
    find $dir -mindepth 2 -exec chown 1000:1000 {} +; \
    find $dir -mindepth 2 -type d -exec chmod 2770 {} +; \
    find $dir -mindepth 2 -type f -exec chmod 0660 {} +; \
  done; \
  if [ -f /srv/pi/data/registry.json ]; then \
    chown 1100:1100 /srv/pi/data/registry.json; \
    chmod 0600 /srv/pi/data/registry.json; \
  fi; \
  if [ -f /srv/pi/data/billing.db ]; then \
    chown 1100:1100 /srv/pi/data/billing.db; \
    chmod 0600 /srv/pi/data/billing.db; \
  fi"

# Shared @preview package cache. 2775 = world-readable so the
# backend (uid 1100) can stat the contents while diagnosing
# disk-quota issues, but only the sandbox group writes new
# packages. SGID makes new subdirs inherit gid 1000.
ExecStart=/usr/bin/install -d -m 2775 -o 1000 -g 1000 /srv/pi/data/typst-packages

# Sandbox's $XDG_CACHE_HOME. 2770 = sandbox rw, backend rw via
# group (so log-collection / debugging from the backend works).
ExecStart=/usr/bin/install -d -m 2770 -o 1000 -g 1000 /srv/pi/data/.cache

# SPA bundle (Caddy mounts read-only).
ExecStart=/usr/bin/install -d -m 0755 -o 0    -g 0    /srv/pi/www

# Caddy state.
ExecStart=/usr/bin/install -d -m 0700 -o 0    -g 0    /srv/caddy/data
ExecStart=/usr/bin/install -d -m 0700 -o 0    -g 0    /srv/caddy/config

# Deployment manifests + secrets stay root-only. stack.env is created
# by remote-deploy.sh from local secrets.
ExecStart=/usr/bin/install -d -m 0700 -o 0    -g 0    /opt/pi

[Install]
WantedBy=pi.service
