# Caddy configuration for the pi-typst-test deployment on
# digi-setu.com (replaces the legacy typst-agent Caddyfile).
#
# Responsibilities:
#   1. Terminate TLS for digi-setu.com + www (Let's Encrypt DNS-01
#      against Cloudflare so we don't need port 80 reachable).
#   2. Serve the static Vue 3 SPA at the apex.
#   3. Reverse-proxy /api/* to FastAPI on 127.0.0.1:8788 (strip the
#      /api prefix to match the dev Vite proxy contract).
#   4. Forward /ws/* (WebSocket — chat + terminal streams) with HTTP/1.1
#      Upgrade preserved and 24h timeouts so the long-lived sockets
#      don't get cut by Caddy's idle defaults.
#
# Secrets (loaded by docker-compose env_file from /opt/pi/stack.env):
#   CLOUDFLARE_API_TOKEN   — scoped "Edit zone DNS" for digi-setu.com
#   ACME_EMAIL             — Let's Encrypt account email
{
	email {$ACME_EMAIL}
	acme_dns cloudflare {$CLOUDFLARE_API_TOKEN}

	servers {
		trusted_proxies static private_ranges
	}
}

# Shared snippet: hardened security headers + compression.
#
# CSP rationale (any change here affects EVERY route, so be surgical):
#
#   default-src 'self'         — deny everything not whitelisted below.
#
#   script-src 'self'          — only our own bundles. Vite builds
#                                produce hashed external <script
#                                type="module"> tags so we DON'T need
#                                'unsafe-inline'. Clerk's vue plugin
#                                makes XHR/WebSocket calls but does
#                                NOT inject 3rd-party <script> tags
#                                from another origin.
#
#   style-src 'self' 'unsafe-inline'
#                              — Tailwind + Vue scoped styles emit
#                                inline <style> blocks. Tightening
#                                this requires a hash-allowlist for
#                                every CSS payload Vite emits, which
#                                breaks every release. Deferred.
#
#   img-src  'self' data: blob: https:
#                              — user uploads (blob:), favicon
#                                (data:), and remote image previews
#                                in the chat (https:). Tighten to
#                                explicit hosts once the upload story
#                                stops fetching arbitrary URLs.
#
#   font-src 'self' data:      — Vite inlines small fonts as data:
#                                URIs, larger ones served from /assets.
#
#   connect-src 'self' https://*.clerk.com https://*.clerk.accounts.dev
#               https://*.clerk.dev https://api.stripe.com
#               https://api.iconify.design https://api.unisvg.com
#               https://api.simplesvg.com
#                              — XHR + WS to ourselves (the wss://
#                                handshake matches 'self' since the
#                                origin is the same as the page),
#                                Clerk session/user APIs, Stripe's
#                                JS SDK config endpoint, and the three
#                                Iconify CDN fallbacks (the @iconify
#                                runtime probes them in order to fetch
#                                JSON manifests for icon collections
#                                referenced as <Icon icon="mdi:..." />).
#                                Without all three, icons silently
#                                disappear after the first 404 and the
#                                Workspace page UI degrades. Stripe
#                                Checkout itself happens via top-level
#                                redirect (NOT in an iframe), so we
#                                don't need frame-src for it.
#
#   frame-src 'self' https://js.stripe.com https://hooks.stripe.com
#                              — reserved in case we ever embed Stripe
#                                Elements. Today: no iframes are used.
#
#   script-src ... 'wasm-unsafe-eval'
#                              — Shiki (markdown code-block highlighter)
#                                ships its grammar engine as a WebAssembly
#                                module that gets compiled at runtime via
#                                WebAssembly.instantiate(). Modern Chrome
#                                requires either 'unsafe-eval' (loose) or
#                                'wasm-unsafe-eval' (tight, only allows
#                                wasm). We choose the tight one — JS eval
#                                stays banned, but wasm compile is allowed.
#
#   frame-ancestors 'none'     — refuse to be embedded ANYWHERE.
#                                Replaces the legacy X-Frame-Options.
#
#   base-uri 'self'            — block <base href="https://evil.tld/">
#                                injection that would relativize all
#                                /assets/ URLs to a remote host.
#
#   form-action 'self'         — every <form> POST stays on-origin.
#                                Clerk sign-in is a top-level redirect
#                                to clerk.digi-setu.com, NOT a form
#                                POST from our page, so this is fine.
#
#   upgrade-insecure-requests  — auto-upgrade any rogue http:// URL
#                                that sneaks in through user content.
#
# Permissions-Policy turns OFF every powerful API the app doesn't
# touch. If a browser plugin / 0-day tries to grab the camera, the
# browser will refuse before the API even responds.
#
# Cross-Origin-* headers harden the page's process isolation so a
# Spectre-style side-channel can't read our memory from a sibling
# origin. We're a 1-origin app, so the strictest values are safe.
(common_headers) {
	header {
		# HTTPS-only for 2 years, includes all subdomains, and is
		# eligible for the Chromium HSTS preload list (submit at
		# https://hstspreload.org once the cert is live).
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

		# Content-Security-Policy. ONE line per directive for
		# readability — Caddy concatenates with `;` itself when
		# emitting the header.
		# Clerk's JS SDK is served from the CNAME you configured in the
		# Clerk dashboard — for digi-setu.com that's
		# https://clerk.digi-setu.com/npm/@clerk/clerk-js@6/...js
		# CSP can't wildcard cross-domain (no *.clerk.* syntax), so we
		# enumerate every host Clerk pulls scripts/XHR from:
		#   - clerk.digi-setu.com   ← production frontend CNAME
		#   - *.clerk.com           ← Clerk-managed JS CDN (npm proxy)
		#   - *.clerk.accounts.dev  ← legacy / dev instance hostnames
		#   - *.clerk.dev           ← Clerk-managed services
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://clerk.digi-setu.com https://*.clerk.com https://*.clerk.accounts.dev https://*.clerk.dev; script-src-elem 'self' https://clerk.digi-setu.com https://*.clerk.com https://*.clerk.accounts.dev https://*.clerk.dev; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://clerk.digi-setu.com https://*.clerk.com https://*.clerk.accounts.dev https://*.clerk.dev https://api.stripe.com https://api.iconify.design https://api.unisvg.com https://api.simplesvg.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"

		# Permissions-Policy: deny every powerful browser API we
		# don't use. The () empty allow-list = "deny everywhere,
		# including this origin".
		#
		# We only list features that current Chrome/Edge/Firefox
		# actually parse. Listing draft / removed features (e.g.
		# ambient-light-sensor, battery, document-domain,
		# execution-while-{not-rendered,out-of-viewport},
		# navigation-override) emits a console warning per page
		# load with no security benefit, and the noise drowns out
		# real CSP violations during incident triage. If a vendor
		# ever re-introduces one of those APIs we'll re-add the
		# entry then.
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), keyboard-map=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=()"

		# Cross-origin isolation. COOP+CORP make the browser
		# treat us as a 1-origin app — a clicked-through tab on
		# evil.tld can't open a window into our session, and a
		# remote <img src="https://digi-setu.com/api/secret">
		# can't be embedded by another origin.
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-site"

		# Legacy / explicit hardening.
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		X-Permitted-Cross-Domain-Policies "none"
		-Server
	}
	encode zstd gzip
}

# Long-running streaming endpoints (/ws/* WebSockets, /api/* SSE-like).
# `flush_interval -1` flushes every write — without it Caddy buffers
# event-stream responses and the UI looks frozen during a chat turn.
(stream_proxy) {
	reverse_proxy 127.0.0.1:8788 {
		flush_interval -1
		transport http {
			read_timeout 24h
			write_timeout 24h
		}
	}
}

digi-setu.com, www.digi-setu.com {
	import common_headers

	# Backend health straight through so uptime probes hit FastAPI.
	handle /healthz {
		reverse_proxy 127.0.0.1:8788
	}

	# WebSocket: chat (`/ws/sessions/{sid}`) + interactive terminals
	# (`/ws/terminal/{tid}`). Caddy auto-detects the Upgrade header.
	handle /ws/* {
		import stream_proxy
	}

	# Everything API-shaped under /api/* goes to FastAPI. We don't
	# strip the prefix because backend routes are already declared as
	# `/api/...` in the FastAPI routers.
	handle /api/* {
		reverse_proxy 127.0.0.1:8788
	}

	# ── /downloads/* — desktop installer artefacts ──────────────
	# Serves the .dmg / .pkg / .zip the operator drops into
	# /srv/pi/downloads on the VM. Cached for an hour by browsers
	# (the URL embeds the version, so a fresh release uses a new
	# filename and dodges the cache automatically).
	#
	# Anti-hotlink: we deliberately do NOT enable directory listing.
	# Users hit specific filenames the /download landing page links
	# to, never the bare /downloads/ index. This is also the reason
	# we keep the artefacts on the VM rather than a public bucket
	# for v1 — keeps the surface area small while we figure out
	# what bandwidth the launch generates.
	handle_path /downloads/* {
		root * /srv/pi/downloads
		header Cache-Control "public, max-age=3600, immutable"
		header Content-Disposition "attachment"
		# Directory browsing is OFF by default in Caddy v2's
		# `file_server` directive — omit the `browse` arg entirely
		# so we don't enumerate every artefact ever staged here.
		file_server
	}

	# Static SPA. `try_files` falls through to index.html so Vue Router
	# wins on hard refreshes of /chat/<sid> etc.
	handle {
		root * /srv/pi/www
		try_files {path} /index.html
		file_server
	}
}

# ── api.digi-setu.com — desktop relay subdomain ─────────────────────
# Hosts the cloud-relay endpoint that desktop clients without BYOK
# keys connect to: `wss://api.digi-setu.com/v1/ws/desktop-relay`. The
# desktop ships this URL hard-coded as the default for `PI_RELAY_BASE`,
# so any change to the hostname / path scheme here breaks every
# already-shipped binary.
#
# Keep the surface MINIMAL: only `/v1/...` is exposed. Anything not
# under `/v1/` returns 404 — we don't want the api subdomain to
# accidentally serve the SPA, the legacy /api routes, or static assets.
#
# Same backend container as the apex (127.0.0.1:8788) for v1; if/when
# the relay grows enough to need its own VM or Cloud Run service we
# can split here without changing the public URL.
#
# DNS / Cloudflare prerequisites (one-time, not Caddy's job):
#   1. In Cloudflare DNS for digi-setu.com:
#        Type:  CNAME (or A — see note below)
#        Name:  api
#        Value: <same target as @ — typically the VM's public hostname>
#        Proxy: leave OFF if you want Caddy to terminate TLS itself
#               (Let's Encrypt DNS-01 needs the Cloudflare API token in
#               stack.env). Turn ON if you'd rather terminate at
#               Cloudflare and let Caddy serve plain HTTP — but then
#               drop the TLS block below and add `cf-connecting-ip`
#               handling like the apex.
#   2. The CLOUDFLARE_API_TOKEN scoped to "Edit zone DNS" must include
#      the api.digi-setu.com subdomain (zone-level scoping covers this
#      automatically).
#   3. After deploying this Caddyfile change, Caddy will request a Let's
#      Encrypt cert for api.digi-setu.com on first request. Allow ~30 s
#      for the DNS-01 challenge to propagate before the relay endpoint
#      is reachable.
api.digi-setu.com {
	import common_headers

	# /v1/ws/desktop-relay — desktop ⇄ server-side pi WebSocket.
	# Same stream_proxy snippet the apex uses for chat/terminal WS so
	# tokens flush per-write and the long-lived socket isn't cut by
	# the default idle timeout.
	handle /v1/ws/* {
		import stream_proxy
	}

	# /v1/health — smoke probe (used by monitoring + the desktop's
	# pre-flight check before opening the relay WS). Plain JSON, no
	# auth, returns immediately.
	#
	# /v1/<other> — future REST endpoints under the same versioned
	# tree. Anything not handled explicitly above falls through here.
	handle /v1/* {
		reverse_proxy 127.0.0.1:8788
	}

	# Lock down everything else. We don't want the api subdomain to
	# accidentally serve the SPA, /healthz (apex-only), or anything
	# under /api/ (also apex-only).
	handle {
		respond 404
	}
}
