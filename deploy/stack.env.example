# /opt/pi/stack.env (mode 0600 root:root)
#
# Populated on the VM by scripts/remote-deploy.sh from a local copy.
# NEVER commit real values. Loaded by systemd's pi.service via
# EnvironmentFile= and by docker-compose.yml via env_file:.

# ── Image ──────────────────────────────────────────────────────────
# Tag pinned by remote-deploy.sh on every push (e.g. :a1b2c3d). Reload
# pi.service to pick up a new image.
BACKEND_IMAGE=us-central1-docker.pkg.dev/digi-setu-dev/digi-setu/pi-backend:latest

# ── ACME / Cloudflare (Caddy DNS-01) ───────────────────────────────
ACME_EMAIL=ops@digi-setu.com
CLOUDFLARE_API_TOKEN=

# ── Vertex AI + ADC ────────────────────────────────────────────────
# `GOOGLE_CLOUD_PROJECT` is where Vertex bills + counts quota. The VM's
# attached service account needs `roles/aiplatform.user` on this project.
# (No JSON key is needed — Vertex picks up Application Default
# Credentials from the GCE metadata server, same path digi-setu-live used.)
GOOGLE_CLOUD_PROJECT=digi-setu-dev
GOOGLE_CLOUD_LOCATION=global

# Optional: override pi's default model on this deploy. Leaving these
# empty falls back to the Dockerfile's PI_MODEL=claude-sonnet-4-6.
# PI_MODEL=claude-sonnet-4-6

# ── Auth (Clerk: managed Google SSO + email + JWKS) ────────────────
# We outsource auth to Clerk (https://clerk.com). Clerk renders the
# sign-in UI, handles Google SSO + magic links + MFA, exposes a
# self-service "Delete account" flow, and signs the session JWT we
# verify on every request.
#
# When CLERK_SECRET_KEY is EMPTY the backend runs in "open dev mode"
# (every request resolves to user_id="dev"). Fine for the staging
# cutover. NEVER deploy public traffic without these set.
#
# Setup checklist (≈ 5 minutes):
#   1. Create a Clerk application at https://dashboard.clerk.com
#      → "Applications" → "Create application".
#      Choose "Email" + "Google" as sign-in methods.
#   2. From the dashboard "API Keys" page copy:
#        • Publishable key  (pk_live_… or pk_test_…)  → CLERK_PUBLISHABLE_KEY
#        • Secret key       (sk_live_… or sk_test_…)  → CLERK_SECRET_KEY
#   3. From "Webhooks" → "Add endpoint":
#        URL    : ${OAUTH_REDIRECT_BASE}/api/auth/webhook
#        Events : user.deleted   (only one we currently react to)
#      Copy the "Signing secret" (whsec_…)        → CLERK_WEBHOOK_SECRET
#   4. From "Domains" add the production hostname (digi-setu.com).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Public origin (used by Caddy for HSTS + CORS allow-list).
OAUTH_REDIRECT_BASE=https://digi-setu.com

# Where /api/feedback delivers messages. Defaults to nchilaka@digi-setu.com
# if unset (see backend/config.py).
FEEDBACK_EMAIL_TO=nchilaka@digi-setu.com

# ── Rate limits (per-user) ─────────────────────────────────────────
# Token-bucket caps in services/rate_limit.py. Defaults are tuned for
# "generous to a single power user, blocking against an obvious bot".
# Set any to 0 to DISABLE that bucket (handy if a customer hits a
# false positive — turn it off, ship, then tune up). Tokens reset
# at UTC midnight; bucket refills are continuous.
#
# RL_WS_CONNECT_CAPACITY=30        # burst of WS opens before throttle
# RL_WS_CONNECT_PER_MIN=60         # steady-state WS opens / min
# RL_PI_SPAWN_CAPACITY=10          # burst of new chats before throttle
# RL_PI_SPAWN_PER_HOUR=60          # steady-state chats / hour
# RL_CHAT_MSG_CAPACITY=20          # burst of prompts before throttle
# RL_CHAT_MSG_PER_MIN=30           # steady-state prompts / min
# RL_FEEDBACK_CAPACITY=3           # burst of /api/feedback before throttle
# RL_FEEDBACK_PER_HOUR=5           # steady-state /api/feedback / hour
# RL_DAILY_TOKEN_BUDGET=1000000    # input+output+cache LLM tokens / day

# ── Subscription credit (per-user, monthly) ───────────────────────
# Translates rate-limit signals into dollar terms for billing. We
# bill no one yet, but the ledger is live and the SPA shows a
# "credits remaining" chip so users learn what their plan covers.
#
# Two knobs decide unit cost:
#   - VM hourly amortised across N concurrent users (BILLING_VM_*).
#   - Anthropic per-MTok pricing (hard-coded in services/billing.py;
#     bump there when Anthropic raises rates).
# Then INFRA_MARKUP applies a flat margin on top of cost. Default
# 1.5 means we keep 50% — the floor for a sustainable SaaS once
# Stripe fees and support time are factored in.
#
# Plan credits below are the dollar cap a user can spend on the LLM
# + amortised compute before we soft-block prompts. Free is a
# generous trial ($2 ≈ ~600k Sonnet input tokens), Pro mirrors
# Claude.ai's $20/mo so users have a familiar mental model.
#
# BILLING_VM_HOURLY_USD=0.0168          # e2-small in us-central1, on-demand
# BILLING_VM_USERS_AT_ONCE=10           # concurrency assumption for amortisation
# BILLING_INFRA_MARKUP=1.5              # 1.0 = at-cost, 2.0 = 2× cost
# BILLING_FREE_CREDIT_USD=2.0           # trial allowance / month
# BILLING_STARTER_CREDIT_USD=20.0       # Starter plan ($20/mo, 1× value)
# BILLING_PRO_CREDIT_USD=200.0          # Pro plan ($100/mo,  2× value — pay $100, spend up to $200)
# BILLING_MAX_CREDIT_USD=350.0          # Enterprise plan ($200/mo, 1.75× value — pay $200, spend up to $350)
#
# Tiers are intentionally subsidised but bounded — Enterprise is sized
# to a realistic power-user ceiling, not "10× the price". If we ever
# see an Enterprise user actually approaching $350/month, that's a
# real signal we should add a bigger plan, not eat more cost.
#
# Note: env var name is still BILLING_MAX_CREDIT_USD because the
# customer's existing prod env files use it; the plan internally is
# now called "enterprise" to match the Stripe product name.

# Plan applied when STRIPE_SECRET_KEY is unset (dev / staging without
# real billing wired up). Default "enterprise" so operators get every
# model unlocked. In production this is ignored — paying users get
# whatever plan their Stripe subscription says.
# BILLING_DEFAULT_PLAN=enterprise


# ── Per-workspace safety limits ────────────────────────────────────
# These are the soft caps that protect us (and the user) from a
# runaway pi turn. They're per-workspace, not per-user.
#
#   WORKSPACE_DISK_QUOTA_MB    Refuse new prompts when the workspace
#                              dir exceeds this many MB. The agent
#                              has already written the file by the
#                              time we notice (we can't unwrite), so
#                              the gate is on the NEXT prompt — the
#                              user gets a clear "your sandbox is
#                              full, delete files or this chat"
#                              message. 100 MB matches the per-chat
#                              guidance ("not 1 GB") we set in
#                              earlier discussions.
#   PROMPT_TIMEOUT_SECONDS     Wall-clock cap on a single pi turn.
#                              When pi gets stuck in a tool loop or
#                              a bash command hangs, we kill the
#                              entire pi subprocess after this many
#                              seconds so the user isn't billed for
#                              an infinite stream of "I'm thinking…"
#                              tokens. 900 = 15 min — enough for a
#                              deep Opus run, short enough that a
#                              runaway costs single-digit dollars.
#                              Set to 0 to disable (NOT recommended
#                              in production).
# WORKSPACE_DISK_QUOTA_MB=100
# PROMPT_TIMEOUT_SECONDS=900

# ── Stripe (USD only for v1) ──────────────────────────────────────
# Stripe is the only paid-billing path enabled today. India + INR
# arrive on Razorpay (or a Merchant of Record like Paddle / Lemon
# Squeezy) once the first non-US paying user asks for it; until
# then anyone billing-side gets a "coming to your region" notice.
#
# Setup checklist (≈ 10 minutes):
#   1. Create a Stripe account at https://dashboard.stripe.com.
#   2. Switch to the right environment (test mode for staging,
#      live mode for production) — every key below comes from the
#      "Developers → API keys" page in that mode.
#   3. Create three recurring USD products in "Products → Add
#      product". One per paid plan, monthly cadence:
#        Starter:    $20 / month
#        Pro:       $100 / month
#        Enterprise: $200 / month
#      Copy the resulting `price_…` ids into STRIPE_PRICE_*. The
#      env var is still STRIPE_PRICE_MAX for backwards compat with
#      existing prod env files, even though the plan id is now
#      "enterprise" internally.
#   4. Create a webhook in "Developers → Webhooks → Add endpoint":
#        URL    : ${OAUTH_REDIRECT_BASE}/api/billing/webhook
#        Events : checkout.session.completed
#                 customer.subscription.updated
#                 customer.subscription.deleted
#      Copy the "Signing secret" (whsec_…) into STRIPE_WEBHOOK_SECRET.
#   5. (Optional) "Settings → Customer portal": tick the plans you
#      want users to be able to switch between. The Manage button in
#      the SPA opens this hosted portal — if it's not configured the
#      user can still cancel by emailing support, but self-serve
#      changes won't work.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=

# Where Stripe redirects after Checkout / Portal exit. Defaults to
# OAUTH_REDIRECT_BASE — set explicitly if you want a different
# success page (e.g. a /welcome route).
# BILLING_RETURN_URL=https://digi-setu.com
