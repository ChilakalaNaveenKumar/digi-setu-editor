# Rust build output (huge — 1-2 GB during a debug build).
src-tauri/target/

# PyInstaller artifacts. The frozen sidecar binary is platform-
# specific and gets rebuilt by `npm run sidecar:build`; checking in
# would just rot the LFS quota.
sidecar/build/
sidecar/dist/
sidecar/__pycache__/
sidecar/*.spec.bak

# Bundled Node + pi-coding-agent. Re-fetched by
# `npm run pi-runtime:fetch`. Total size is ~80 MB per platform; we
# keep it out of git so clones stay fast.
pi-runtime/vendor/node-*/
pi-runtime/vendor/pi/
pi-runtime/vendor/extensions/

# Local node_modules (Tauri CLI + plugin packages).
node_modules/
frontend/node_modules/

# Vite / TypeScript build output. Regenerated by
# `npm run build` inside `frontend/`; not part of the source tree.
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/*.local

# Python toolchain inside the backend fork. The venv lives here so
# the sidecar build script can `source .venv/bin/activate` without
# wandering up to a project-level virtualenv. Re-created from
# `requirements.txt` by `npm run sidecar:build`.
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/*.py[cod]

# Local data. In desktop dev mode the backend writes registry.json,
# workspaces/, audits/ etc. under ~/.digi-setu/, but if PI_DATA_ROOT
# isn't set the legacy `backend/data/` path is used as fallback —
# never commit either.
backend/data/

# User-supplied secrets. ~/.digi-setu/.env is the real config home in
# desktop mode; backend/.env is only ever a developer override.
backend/.env
backend/.env.*
!backend/.env.example

# Editor / OS junk.
.DS_Store
.idea/
.vscode/

# Mobile-only icon outputs — only relevant when bundling iOS / Android,
# which the Tauri shell doesn't currently target. Saves ~3 MB on every
# clone and they regenerate on demand via `tauri icon ...`.
src-tauri/icons/android/
src-tauri/icons/ios/

# Microsoft Store square logos — only needed when bundling for the
# Microsoft Store; we're shipping plain MSI/NSIS so these would just
# be dead weight in the repo.
src-tauri/icons/Square*.png
src-tauri/icons/StoreLogo.png

# Auto-generated Tauri capability schemas.
src-tauri/gen/

# Tauri/Cargo lockfile is intentionally NOT ignored — we want repro
# builds.

# Third-party licenses bundle. Generated by
# `desktop/scripts/gen-third-party-licenses.mjs` against the
# vendored node_modules + Cargo.lock at build time, so it changes
# every time a dep is bumped. Keep a single source of truth (the
# script) in git, not the 1+ MB output.
THIRD_PARTY_LICENSES.txt
