{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to the main webview. Each permission is the minimum needed for the SPA to do its job; nothing here grants raw filesystem or shell access — those are mediated by our IPC commands in src/commands.rs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",

    "shell:default",

    "opener:default",
    "opener:allow-open-url",

    "dialog:default",
    "dialog:allow-open",

    "os:default",
    "os:allow-platform",
    "os:allow-version",
    "os:allow-os-type",
    "os:allow-locale",
    "os:allow-arch",

    "fs:default",

    "deep-link:default",
    "deep-link:allow-get-current",
    "deep-link:allow-register",
    "deep-link:allow-unregister",
    "deep-link:allow-is-registered"
  ]
}
