{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Digi Setu",
  "version": "0.1.0",
  "identifier": "com.digisetu.pi-typst-test",
  "build": {
    "beforeDevCommand": "cd frontend && npm run dev -- --host 127.0.0.1 --port 5173",
    "beforeBuildCommand": "cd frontend && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Digi Setu",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Digi Setu — local AI coding companion",
    "longDescription": "Digi Setu desktop runs the Digi Setu coding agent against folders on your own machine. Pick a folder, chat with the agent, watch it edit files, terminals, and PDFs — all local, with shadow-git checkpoints so every AI edit is revertable.",
    "copyright": "© 2026 Digi Setu",
    "publisher": "Digi Setu",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../pi-runtime/vendor": "pi-runtime/vendor",
      "../sidecar/dist": "sidecar/dist"
    },
    "externalBin": [
      "../sidecar/dist/pi-typst-sidecar"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": ["en-US"]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["pi-typst-test", "digi-setu"]
      }
    }
  }
}
