// 'sqrt(radicand)'              square root
// 'root(index, radicand)'       general root, with explicit index
//   index = none -> sqrt without index (same as sqrt())

= Square roots

$ sqrt(2) $
$ sqrt(3 - 2 sqrt(2)) = sqrt(2) - 1 $
$ sqrt((x + 1)^2 + (y - 1)^2) $

= Indexed roots

$ root(3, x) quad root(4, x) quad root(n, x) $

= Nested

$ root(3, root(2, x)) = root(6, x) $

= Quadratic formula

$ x = (-b plus.minus sqrt(b^2 - 4 a c)) / (2 a) $
